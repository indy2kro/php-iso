#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpIso\Cli\IsoTool;

exit((static function (): int {
    foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $file) {
        if (file_exists($file)) {
            require $file;
            break;
        }
    }

    $application = new IsoTool();

    return $application->run();
})());
